ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.pdf",path = "results/standard/",device = cairo_pdf,height = 4,width=8)
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.svg",path = "results/standard/",device = 'svg',height = 4,width=8)
legend <- ggplot() +
geom_segment(aes(1,0,xend=1,yend=al), arrow=arrow(length=unit(.25,"cm")),color = '#636363',linewidth = 0.5) +
geom_segment(aes(1,0,xend=1,yend=-al), arrow=arrow(length=unit(.25,"cm")),color = '#636363',linewidth = 0.5) +
geom_segment(aes(0.9,0,xend=1.1,yend=0),color = '#636363',linewidth = 0.5) +
annotate("text", x=1.15, y=(al/2),  vjust=0,hjust=0, label="Countries with\nincreasing\nemissions",color = '#636363') +
annotate("text", x=1.15, y=-(al/2), vjust=1,hjust=0, label="Countries with\ndecreasing\nemissions",color = '#636363') +
xlim(.9,2.5) +
scale_y_continuous(limits = y_range_scaling) +
coord_cartesian(clip = "off") +
theme_wl_empty()
plot <- p1 + legend + plot_layout(widths=c(5,1))
plot
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.png",path = "results/standard/",device = "png",height = 4,width=8,dpi=300)
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.pdf",path = "results/standard/",device = cairo_pdf,height = 4,width=8)
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.svg",path = "results/standard/",device = 'svg',height = 4,width=8)
## Aggregate emissions data
data_sectors <- data_edgar %>%
group_by(iso,country,sector_lv2,sector_lv2_order,year) %>%
summarise(value=sum(value,na.rm=T)/1e9) %>%
filter(year %in% c(max_year-1,max_year))
data_sectors <- data_sectors %>%
rbind(.,data_edgar %>%
group_by(iso,country,year) %>%
summarise(value=sum(value,na.rm=T)/1e9) %>%
filter(year %in% c(max_year-1,max_year)) %>%
mutate(sector_lv2="Total"))
## Group emissions into increases and decreases
data_sectors <- data_sectors %>%
group_by(iso,sector_lv2) %>%
mutate(change=last(value)-first(value)) %>%
mutate(category=ifelse(change>0,"increase","decrease"))
data_sectors <- data_sectors %>%
filter(year==max_year) %>%
group_by(sector_lv2,sector_lv2_order,category) %>%
summarise(change=sum(change,na.rm=T),n=n())
## Calculate total changes
data_sectors <- data_sectors %>%
group_by(sector_lv2) %>%
mutate(total_change=sum(change))
## Arrange levels
data_sectors$label <- data_sectors$sector_lv2
data_sectors$label <- gsub("\\| ","\n",data_sectors$label)
data_sectors$label <- as.factor(data_sectors$label)
data_sectors$label <- fct_reorder(data_sectors$label,data_sectors$sector_lv2_order)
data_sectors$label <- fct_relevel(data_sectors$label,"Total",after=0)
data_sectors <- data_sectors %>% filter(sector_lv2!="Total")
## Plot
p1 <- data_sectors %>% ggplot(.) +
geom_col(aes(x=label,y=change,fill=sector_lv2,alpha=category),color="#252525",linewidth=0.25) +
geom_point(aes(x=label,y=total_change)) +
theme_wl() +
scale_fill_manual(values=colours_9_sectors) +
scale_alpha_discrete(range=c(0.5,1)) +
scale_x_discrete(labels = function(x) str_wrap(x, width = 10)) +
theme(legend.position="none",
axis.title = element_blank(),
axis.text.x = element_text(vjust=1)) +
labs(title="Change in greenhouse gas emissions by sector last year",
subtitle=bquote(paste("GtCO"[2], "e, 2023-2024")),
caption="⌂ UNEP Emissions Gap Report 2026    ⌂ Data: EDGAR v10")
y_range_scaling <- layer_scales(p1)$y$range$range
al <- abs(y_range_scaling[1])/2
p1 <- p1 + geom_text(data=data_sectors %>% filter(change>0),
aes(x=label,y=change+al*0.75,label=paste0(ifelse(total_change>0,"+",""),round(total_change,2))),
color = '#636363')
y_range_scaling <- layer_scales(p1)$y$range$range
al <- abs(y_range_scaling[1])/2
legend <- ggplot() +
geom_segment(aes(1,0,xend=1,yend=al), arrow=arrow(length=unit(.25,"cm")),color = '#636363',linewidth = 0.25) +
geom_segment(aes(1,0,xend=1,yend=-al), arrow=arrow(length=unit(.25,"cm")),color = '#636363',linewidth = 0.25) +
geom_segment(aes(0.9,0,xend=1.1,yend=0),color = '#636363',linewidth = 0.25) +
annotate("text", x=1.15, y=(al/2),  vjust=0,hjust=0, label="Countries with\nincreasing\nemissions",color = '#636363') +
annotate("text", x=1.15, y=-(al/2), vjust=1,hjust=0, label="Countries with\ndecreasing\nemissions",color = '#636363') +
xlim(.9,2.5) +
scale_y_continuous(limits = y_range_scaling) +
coord_cartesian(clip = "off") +
theme_wl_empty()
plot <- p1 + legend + plot_layout(widths=c(5,1))
plot
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.png",path = "results/standard/",device = "png",height = 4,width=8,dpi=300)
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.pdf",path = "results/standard/",device = cairo_pdf,height = 4,width=8)
ggsave(plot,filename = "UNEP-EGR-2025-sector-change-1yr.svg",path = "results/standard/",device = 'svg',height = 4,width=8)
