## Aggregate emissions data
data_sectors <- data_edgar %>%
group_by(year,sector_lv2,sector_lv2_order) %>%
summarise(value=sum(value,na.rm=T)/1e9)
data_sectors_luc <- data_gcb_luc %>%
filter(country=="Global") %>%
mutate(value=value/1e9)
# Add the GCB projection for 2024 and join
#data_sectors_luc <- data_sectors_luc %>%
#  add_row(year=max_year,value=gcb_luc_projection)
data_sectors_luc <- data_sectors_luc %>%
mutate(sector_lv2="Land use change (LULUCF)") %>%
mutate(sector_lv2_order=8) %>%
select(-iso,-country)
data_sectors <- rbind(data_sectors,data_sectors_luc) %>%
filter(year>=1990)
## Arrange levels
data_sectors$sector_lv2 <- as.factor(data_sectors$sector_lv2)
data_sectors$sector_lv2 <- fct_reorder(data_sectors$sector_lv2,data_sectors$sector_lv2_order)
data_sectors <- data_sectors %>% arrange(year,sector_lv2)
## Calculate the rate of change up to 10 years ago
label_long_term <- data_sectors %>%
filter(year<=max_year-9) %>%
group_by(year) %>%
summarise(value=sum(value)) %>%
mutate(change=growth_rate(year,value)$rate*100) %>%
mutate(change=round(change,1)) %>%
mutate(change=ifelse(change>0,paste0("+",change,"%/yr"),paste0("-",abs(change),"%/yr"))) %>%
slice(c(1, n()))
## Calculate the rate of change over the past 10 years
label_medium_term <- data_sectors %>%
filter(year>=max_year-9) %>%
group_by(year) %>%
summarise(value=sum(value)) %>%
mutate(change=growth_rate(year,value)$rate*100) %>%
mutate(change=round(change,1)) %>%
mutate(change=ifelse(change>0,paste0("+",change,"%/yr"),paste0("-",abs(change),"%/yr"))) %>%
slice(c(1, n()))
## Calculate the rate of change over the past 3 years
label_short_term <- data_sectors %>%
filter(year>=max_year-1) %>%
group_by(year) %>%
summarise(value=sum(value)) %>%
mutate(change=growth_rate(year,value)$rate*100) %>%
mutate(change=round(change,1)) %>%
mutate(change=ifelse(change>0,paste0("+",change,"%/yr"),paste0("-",abs(change),"%/yr"))) %>%
slice(c(1, n()))
## Create labels for gases, calculate position
label_sectors <- data_sectors %>%
ungroup() %>%
filter(year==max(data_sectors$year)) %>%
arrange(desc(sector_lv2)) %>%
mutate(label_position=value) %>%
mutate(label_position=cumsum(label_position)) %>%
mutate(label_position=label_position-(value/2)) %>%
select(sector_lv2,label_position)
## Create labels for the totals
labels_totals <- data_sectors %>%
group_by(year) %>%
summarise(value=sum(value)) %>%
filter(year %in% c(1990,2000,2010,label_medium_term$year[1],max_year))
## Plot
p1 <- data_sectors %>% ggplot(.) +
geom_col(aes(x=year,y=value,fill=sector_lv2),color="#252525",linewidth=0.25, width=1) +
## Totals listed on top
geom_segment(data=labels_totals,aes(x = year,xend = year,y = value,yend = value + 2),color="#636363") +
geom_text(data=labels_totals,aes(x=year,y=value+4,label=paste0(round(value,1))),
vjust=0,size=3.5,color="#636363") +
## first decades bracket
geom_segment(data=label_long_term,aes(x = first(year), xend = last(year), y = last(value)+10, yend = last(value)+10),color="#636363",size = 0.25) +
geom_segment(data=label_long_term,aes(x = first(year), xend = first(year), y = last(value)+10, yend = last(value)+8),color="#636363",size = 0.25) +
geom_segment(data=label_long_term,aes(x = last(year), xend = last(year), y = last(value)+10, yend = last(value)+8),color="#636363",size = 0.25) +
geom_text(data=label_long_term,aes(x=first(year)+(last(year)-first(year))/2,y=last(value)+12,label=change),
vjust=0,size=3.5,color="#636363") +
## first decades bracket
geom_segment(data=label_medium_term,aes(x = first(year), xend = last(year), y = last(value)+10, yend = last(value)+10),color="#636363",size = 0.25) +
geom_segment(data=label_medium_term,aes(x = first(year), xend = first(year), y = last(value)+10, yend = last(value)+8),color="#636363",size = 0.25) +
geom_segment(data=label_medium_term,aes(x = last(year), xend = last(year), y = last(value)+10, yend = last(value)+8),color="#636363",size = 0.25) +
geom_text(data=label_medium_term,aes(x=first(year)+(last(year)-first(year))/2,y=last(value)+12,label=change),
vjust=0,size=3.5,color="#636363") +
## last decade bracket
geom_segment(data=label_short_term,aes(x = first(year), xend = last(year), y = last(value)+14, yend = last(value)+14),color="#636363",size = 0.25) +
geom_segment(data=label_short_term,aes(x = first(year), xend = first(year), y = last(value)+14, yend = last(value)+12),color="#636363",size = 0.25) +
geom_segment(data=label_short_term,aes(x = last(year), xend = last(year), y = last(value)+14, yend = last(value)+12),color="#636363",size = 0.25) +
geom_text(data=label_short_term,aes(x=first(year)+(last(year)-first(year))/2,y=last(value)+16,label=change),
vjust=0,size=3.5,color="#636363") +
theme_wl_bar_trend() +
coord_cartesian(clip = "off") +
scale_fill_manual(values=colours_9_sectors) +
scale_y_continuous(breaks = c(0, 20, 40, 60)) +
coord_cartesian(ylim = c(0, 65), clip = "off") +
scale_x_continuous(breaks=c(1990,2000,2010,label_medium_term$year[1],max(data_sectors$year)),
expand = expansion(mult = c(0.05, 0.01)))+
theme(axis.title = element_blank(),
legend.position = "none") +
labs(title="Total net greenhouse gas emissions",
subtitle=bquote(paste("GtCO"[2], "e/year")),
caption=paste0("⌂ ",label_unep,"    ⌂ Data: ",label_edgar,", ",label_gcb,"\n⌂ Note: GWP100 AR6; net land use change (LULUCF) emissions based on bookkeeping conventions"))
p2 <- label_sectors %>%
ggplot(.,aes(x=1,y=label_position,label=sector_lv2,color=sector_lv2)) +
geom_text_repel(
nudge_x      = 3.5,
direction    = "y",
hjust        = 0,
segment.size = 0.3,
point.size = NA,
size=3.25,
force=3
) +
# geom_text_repel(
#   hjust=0,
#   direction = "y",
#   nudge_x = 5,
#   nudge_y = 3,
#   point.size = NA,
#   size=3.5,
#   show.legend = FALSE,
#   box.padding = 0.2,
#   force = 0.1,
#   segment.size = 0.3,
#   segment.curvature = -0.2) +
scale_colour_manual(values=colours_9_sectors) +
scale_y_continuous(limits = c(0,65)) +
scale_x_continuous(expand = expansion(mult = c(0.005, 0.05))) +
theme_wl_empty()
plot <- p1 + plot_spacer() + p2 + plot_layout(widths=c(5,-0.25,1.75))
plot
ggsave(plot,filename = "UNEP-EGR-2026-total-sector-trend.png",path = "results/standard/",device = "png",height = 4,width=8,dpi=300)
ggsave(plot,filename = "UNEP-EGR-2026-total-sector-trend.pdf",path = "results/standard/",device = cairo_pdf,height = 4,width=8)
ggsave(plot,filename = "UNEP-EGR-2026-total-sector-trend.svg",path = "results/standard/",device = 'svg',height = 4,width=8)
