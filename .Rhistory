geom_text_repel(aes(x = 1, y = value, label = str_wrap(var, 20), colour = var),
hjust = 0,
nudge_x = 0.4,
nudge_y = 0.75,
direction = "y",
point.size = NA,
size = 3.5,
show.legend = FALSE,
min.segment.length = 0,
box.padding = 0.2,
force = 0.1,
segment.size = 0.25
) +
scale_colour_manual(values=c("JRC-NGHGI (inventories)"="#7dd396ff",
"Bookkeeping average" = "#3a5e91ff",
"OSCAR"= "#74a6d4ff",
"LUCE" = "#74a6d4ff",
"BLUE" = "#74a6d4ff",
"FAOSTAT" = "#4f8455ff")) +
scale_y_continuous(limits = layer_scales(p1)$y$range$range) +
scale_x_continuous(expand = expansion(mult = c(0, 0.01)),limits=c(1,6)) +
theme_wl_empty() +
theme(legend.position="none")
plot <- p1 + plot_spacer() + p2 + plot_layout(widths = c(4.5,-0.3,2.9))
plot
ggsave(plot,filename = "UNEP-EGR-2026-total-luc-differences.png",path = "results/standard/",device = "png",height = 4,width=8,dpi=300)
ggsave(plot,filename = "UNEP-EGR-2026-total-luc-differences.pdf",path = "results/standard/",device = cairo_pdf,height = 4,width=8)
ggsave(plot,filename = "UNEP-EGR-2026-total-luc-differences.svg",path = "results/standard/",device = 'svg',height = 4,width=8)
## Save data
wb <- createWorkbook()
addWorksheet(wb,"info")
addWorksheet(wb,"data")
info = data.frame(a=c("Author","Contact","Data sources","See also"),
b=c("William F. Lamb",
"william.lamb@pik-potsdam.de",
paste0(ref_gcb,"; ",ref_grassi),
ref_lamb))
writeData(wb, sheet = "info",info,colNames = F, rowNames = F)
writeData(wb, sheet = "data",data_luc_diff,colNames = T, rowNames = F)
saveWorkbook(wb,paste0("results/standard/UNEP-EGR-2026-total-luc-differences.xlsx"),overwrite=T)
## Aggregate emissions data
data_sankey_left <- data_fuels %>% rename(category=fuel) %>% mutate(value=value/1e9)
data_sankey_right <- data_edgar %>%
group_by(year,sector_lv1,sector_lv2,sector_lv2_order,gas) %>%
summarise(value=sum(value,na.rm=T)/1e9)
data_sankey_luc <- data_gcb_luc %>%
filter(country=="Global") %>%
mutate(value=value/1e9)
# Add the GCB projection and join
# data_sankey_luc <- data_sankey_luc %>%
#   add_row(year=2024,value=gcb_luc_projection)
data_sankey_luc <- data_sankey_luc %>%
mutate(sector_lv2="Land use change (LULUCF)") %>%
mutate(sector_lv2_order=8) %>%
select(-iso,-country)
data_sankey_left <- rbind(data_sankey_left,data_sankey_luc %>% mutate(category="Non-fossil"))
data_sankey_right <- rbind(data_sankey_right,data_sankey_luc %>% mutate(gas="CO2 LULUCF"))
## Filter out tiny flows
data_sankey_left <- data_sankey_left %>%
filter(!is.na(value)) %>%
left_join(.,data_sankey_left %>% group_by(year) %>% summarise(total=sum(value,na.rm=T)),by=join_by(year)) %>%
mutate(share=value/total) %>%
filter(share>=0.002)
data_sankey_right <- data_sankey_right %>%
filter(!is.na(value)) %>%
left_join(.,data_sankey_right %>% group_by(year) %>% summarise(total=sum(value,na.rm=T)),by=join_by(year)) %>%
mutate(share=value/total) %>%
filter(share>=0.002)
## Fix levels
data_sankey_left$category <- as.factor(data_sankey_left$category)
data_sankey_left$category <- fct_relevel(data_sankey_left$category,"Coal","Oil","Gas","Oil and gas","Other fossil","Non-fossil")
data_sankey_left$sector_lv2 <- as.factor(data_sankey_left$sector_lv2)
data_sankey_left$sector_lv2 <- fct_reorder(data_sankey_left$sector_lv2,data_sankey_left$sector_lv2_order)
data_sankey_right$sector_lv2 <- as.factor(data_sankey_right$sector_lv2)
data_sankey_right$sector_lv2 <- fct_reorder(data_sankey_right$sector_lv2,data_sankey_right$sector_lv2_order)
data_sankey_right$gas <- as.factor(data_sankey_right$gas)
data_sankey_right$gas <- fct_relevel(data_sankey_right$gas,"CO2 Fossil","CH4","N2O","F-gases","CO2 LULUCF")
## Filter year
data_sankey_left <- data_sankey_left %>% filter(year==2020)
data_sankey_right <- data_sankey_right %>% filter(year==2020)
p1 <- ggplot(data_sankey_left,aes(axis1 = category,axis2 = sector_lv2,y = value)) +
scale_x_discrete(expand = c(.1, .1)) +
geom_alluvium(aes(fill = category), width = 0.2, color="#525252",alpha=0.8,linewidth=0.25) +
geom_stratum(width = 0.1, color = "black",fill="grey80",linewidth=0.25) +
scale_x_discrete(expand=c(0,0)) +
scale_y_continuous(expand=c(0,0)) +
scale_fill_manual(values=colours_fuels,na.value = "grey80") +
theme_wl_empty() +
theme(
axis.title = element_blank(),
plot.margin = margin(5,0,5,5),
legend.position="none",
plot.caption = element_text(family = "sans",size = 9,hjust = 0,color = '#bdbdbd',margin = margin(t = 10))
) +
labs(title = "Total net greenhouse gas emissions by fuel, sector and gas",
caption=paste0("⌂ ",label_unep,"    ⌂ Data: ",label_edgar,", IEA 2026, ",label_gcb,"    ⌂ Note: flows less than 1/500th of total are hidden"))
p2 <- ggplot(data_sankey_right,aes(axis1 = sector_lv2,axis2 = gas,y = value)) +
scale_x_discrete(expand = c(.1, .1)) +
geom_alluvium(aes(fill = gas), width = 0.2, color="#525252",alpha=0.8,linewidth=0.25) +
geom_stratum(width = 0.1, color = "black",fill="grey80",linewidth=0.25) +
scale_x_discrete(expand=c(0,0)) +
scale_y_continuous(expand=c(0,0)) +
scale_fill_manual(values=colours_gases,na.value = "grey80") +
coord_cartesian()+
theme_wl_empty() +
theme(
axis.title = element_blank(),
plot.margin = margin(5,0,5,5),
legend.position="none"
)
label_fuel <- data_sankey_left %>%
group_by(category) %>%
summarise(value=sum(value)) %>%
mutate(total=sum(data_sankey_left$value)) %>%
arrange(desc(category)) %>%
mutate(label_position=value) %>%
mutate(label_position=cumsum(label_position)) %>%
mutate(label_position=label_position-(value/2))
label_fuel <- label_fuel %>% ggplot(.,aes(x=1,y=label_position,label=str_wrap(category,15),color=category)) +
#geom_text_repel(nudge_x=-0.5,hjust=1,force = 20,max.iter = 2000,segment.curvature = -0.25,direction="y") +
geom_text_repel(
hjust=0,
direction = "y",
nudge_x = -5,
point.size = NA,
size=3.5,
show.legend = FALSE,
box.padding = 0.2,
force = 0.1,
segment.size = 0.3,
segment.curvature = -0.2) +
scale_y_continuous(limits=c(0,max(label_fuel$total)),expand=c(0,0)) +
scale_color_manual(values=colours_fuels) +
theme_wl_empty() +
theme(legend.position="none")
label_sector <- data_sankey_right %>%
group_by(sector_lv2) %>%
summarise(value=sum(value)) %>%
mutate(total=sum(data_sankey_right$value)) %>%
arrange(desc(sector_lv2)) %>%
mutate(label_position=value) %>%
mutate(label_position=cumsum(label_position)) %>%
mutate(label_position=label_position-(value/2)) %>%
mutate(fraction=label_position/total)
label_sector <- label_sector %>% ggplot(.,aes(x=1,y=label_position,label=sector_lv2)) +
geom_text(aes(label = sector_lv2),size=3.5,color="#525252",hjust=0.5) +
scale_y_continuous(limits=c(0,max(label_sector$total)),expand=c(0,0)) +
coord_cartesian(clip="off") +
theme_wl_empty()
label_gas <- data_sankey_right %>%
group_by(gas) %>%
summarise(value=sum(value)) %>%
mutate(total=sum(data_sankey_right$value)) %>%
arrange(desc(gas)) %>%
mutate(label_position=value) %>%
mutate(label_position=cumsum(label_position)) %>%
mutate(label_position=label_position-(value/2))
label_gas <- label_gas %>% ggplot(.,aes(x=1,y=label_position,label=gas,color=gas)) +
geom_text_repel(
hjust=0,
direction = "y",
nudge_x = 5,
point.size = NA,
size=3.5,
show.legend = FALSE,
box.padding = 0.2,
force = 0.1,
segment.size = 0.3,
segment.curvature = -0.2) +
scale_y_continuous(limits=c(0,max(label_gas$total)),expand=c(0,0)) +
scale_color_manual(values=colours_gases) +
theme_wl_empty() +
theme(legend.position="none")
plot <- label_fuel + p1 + label_sector + p2 + label_gas + plot_layout(widths = c(0.4,1,0.8,1,0.4))
plot
ggsave(plot,filename = "UNEP-EGR-2026-sankey.png",path = "results/standard/",device = "png",height = 6,width=9,dpi=300)
ggsave(plot,filename = "UNEP-EGR-2026-sankey.pdf",path = "results/standard/",device = cairo_pdf,height = 6,width=9)
ggsave(plot,filename = "UNEP-EGR-2026-sankey.svg",path = "results/standard/",device = 'svg',height = 6,width=9)
